    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="idadeUsuario" type="Integer" array="False" size=""/>
            <output expression="&quot;Insira sua idade:&quot;" newline="True"/>
            <input variable="idadeUsuario"/>
            <if expression="idadeUsuario &gt;= 18">
                <then>
                    <output expression="&quot;Voc&#234; &#233; maior de idade!&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;Voc&#234; &#233; menor de idade &#55357;&#56866;&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
