<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="S1_R3_AT2 Valor da compra"/>
        <attribute name="authors" value="DES-I1HSB"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2025-04-08 01:39:23 "/>
        <attribute name="created" value="REVTLUkxSFNCO0VTTjUxMk4xMjYyODQzOzIwMjUtMDQtMDg7IjAxOjI3OjI0ICI7MjYyMg=="/>
        <attribute name="edited" value="REVTLUkxSFNCO0VTTjUxMk4xMjYyODQzOzIwMjUtMDQtMDg7IjAxOjM5OjIzICI7MjsyNzMz"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="valorCompra, valorDesconto" type="Real" array="False" size=""/>
            <output expression="&quot;Insira o valor da compra:&quot;" newline="True"/>
            <input variable="valorCompra"/>
            <if expression="valorCompra &gt;= 100">
                <then>
                    <assign variable="valorDesconto" expression="valorCompra * 0.1"/>
                    <output expression="&quot;O valor do desconto &#233; R$ &quot; &amp; valorDesconto" newline="True"/>
                    <assign variable="valorCompra" expression="valorCompra - valorDesconto"/>
                    <output expression="&quot;O valor da compra &#233; R$ &quot; &amp; valorCompra" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;O valor total da compra &#233; R$ &quot; &amp; valorCompra" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
